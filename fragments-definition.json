{
  "cpu": 256,
  "environment": [
    {
      "name": "AWS_REGION",
      "value": "us-east-1"
    },
    {
      "name": "AWS_COGNITO_POOL_ID",
      "value": "us-east-1_1na2EIvTb"
    },
    {
      "name": "PORT",
      "value": "80"
    },
    {
      "name": "NODE_ENV",
      "value": "production"
    },
    {
      "name": "AWS_S3_BUCKET_NAME",
      "value": "aarif24-fragments"
    },
    {
      "name": "LOG_LEVEL",
      "value": "info"
    },
    {
      "name": "AWS_COGNITO_CLIENT_ID",
      "value": "7d6r58bms7s16h2fao0enhfkff"
    }
  ],
  "essential": true,
  "healthCheck": {
    "command": [
      "CMD-SHELL",
      "curl -f http://localhost:80/ || exit 1"
    ],
    "interval": 30,
    "retries": 3,
    "startPeriod": 60,
    "timeout": 5
  },
  "image": "905418069913.dkr.ecr.us-east-1.amazonaws.com/fragments:latest",
  "logConfiguration": {
    "logDriver": "awslogs",
    "options": {
      "awslogs-group": "/ecs/fragments-task",
      "awslogs-region": "us-east-1",
      "awslogs-stream-prefix": "ecs"
    }
  },
  "memory": 512,
  "mountPoints": [],
  "name": "fragments-container",
  "portMappings": [
    {
      "containerPort": 80,
      "hostPort": 80,
      "protocol": "tcp"
    }
  ],
  "systemControls": [],
  "volumesFrom": []
}
